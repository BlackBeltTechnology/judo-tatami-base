<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>hu.blackbelt.judo.tatami</groupId>
		<artifactId>judo-tatami-base-parent</artifactId>
		<version>${revision}</version>
	</parent>

	<artifactId>judo-tatami-asm2keycloak</artifactId>
	<packaging>bundle</packaging>
	<name>Judo :: Tatami :: Asm2Keycloak</name>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
			</plugin>


			<plugin>
				<groupId>org.apache.felix</groupId>
				<artifactId>maven-bundle-plugin</artifactId>
				<extensions>true</extensions>
				<configuration>
					<obrRepository>NONE</obrRepository>
					<instructions>
						<Export-Package>
							hu.blackbelt.judo.tatami.asm2keycloak.*;version=${project.version}
						</Export-Package>
						<Import-Package>
                            ${osgi-default-import},
                            *
						</Import-Package>
					</instructions>
				</configuration>
			</plugin>
		</plugins>
	</build>

	<!-- Zeta-only: no Epsilon. ETL lives in judo-tatami-asm2keycloak-etl (split-etl-artifacts). -->
	<dependencies>
        <dependency>
			<groupId>hu.blackbelt.judo.meta</groupId>
			<artifactId>hu.blackbelt.judo.meta.asm.model</artifactId>
		</dependency>
		<dependency>
			<groupId>hu.blackbelt.judo.meta</groupId>
			<artifactId>hu.blackbelt.judo.meta.keycloak.model</artifactId>
		</dependency>
		<dependency>
			<groupId>hu.blackbelt.judo.tatami</groupId>
			<artifactId>judo-tatami-core</artifactId>
		</dependency>
		<dependency>
			<groupId>hu.blackbelt.judo.tatami</groupId>
			<artifactId>judo-tatami-util</artifactId>
		</dependency>

		<dependency>
			<groupId>hu.blackbelt.judo.tatami</groupId>
			<artifactId>judo-tatami-psm2asm</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- test fixtures build the input ASM with the psm2asm ETL engine -->
		<dependency>
			<groupId>hu.blackbelt.judo.tatami</groupId>
			<artifactId>judo-tatami-psm2asm-etl</artifactId>
			<scope>test</scope>
		</dependency>

		<!-- Zeta Framework -->
		<dependency>
			<groupId>hu.blackbelt.judo.zeta</groupId>
			<artifactId>hu.blackbelt.judo.zeta.annotations</artifactId>
		</dependency>
		<dependency>
			<groupId>hu.blackbelt.judo.zeta</groupId>
			<artifactId>hu.blackbelt.judo.zeta.transformation-core</artifactId>
		</dependency>
		<dependency>
			<groupId>hu.blackbelt.judo.zeta</groupId>
			<artifactId>hu.blackbelt.judo.zeta.common</artifactId>
		</dependency>
		<dependency>
			<groupId>hu.blackbelt.judo.meta</groupId>
			<artifactId>hu.blackbelt.judo.meta.psm.model.northwind</artifactId>
		</dependency>

		<!-- Test utilities -->
		<dependency>
			<groupId>hu.blackbelt.judo.tatami</groupId>
			<artifactId>judo-tatami-test-utils</artifactId>
			<version>${project.version}</version>
			<scope>test</scope>
		</dependency>
	</dependencies>
</project>
